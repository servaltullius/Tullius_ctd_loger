<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>SkyrimDiagDumpToolWinUI</RootNamespace>
    <AssemblyName>SkyrimDiagDumpToolWinUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SkyrimDiagVersion)' != ''">
    <Version>$(SkyrimDiagVersion)</Version>
    <AssemblyVersion>$(SkyrimDiagVersion).0</AssemblyVersion>
    <FileVersion>$(SkyrimDiagVersion).0</FileVersion>
    <InformationalVersion>$(SkyrimDiagInformationalVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>$(SkyrimDiagApplicationManifest)</ApplicationManifest>
  </PropertyGroup>

  <Target Name="RequireSkyrimDiagVersion" BeforeTargets="PrepareForBuild"
          Condition="'$(SkyrimDiagVersion)' == '' or '$(SkyrimDiagInformationalVersion)' == '' or '$(SkyrimDiagApplicationManifest)' == ''">
    <Error Text="SkyrimDiagVersion, SkyrimDiagInformationalVersion, and SkyrimDiagApplicationManifest are required. Use scripts\build-winui.cmd." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260101001" />
  </ItemGroup>
</Project>
