#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SKYDIAG_VERSION_MAJOR@,@SKYDIAG_VERSION_MINOR@,@SKYDIAG_VERSION_PATCH@,0
 PRODUCTVERSION @SKYDIAG_VERSION_MAJOR@,@SKYDIAG_VERSION_MINOR@,@SKYDIAG_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @SKYDIAG_FILE_TYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "servaltullius\0"
      VALUE "FileDescription", "@SKYDIAG_FILE_DESCRIPTION@\0"
      VALUE "FileVersion", "@SKYDIAG_VERSION_STRING@.0\0"
      VALUE "InternalName", "@SKYDIAG_ORIGINAL_FILENAME@\0"
      VALUE "OriginalFilename", "@SKYDIAG_ORIGINAL_FILENAME@\0"
      VALUE "ProductName", "Tullius CTD Logger\0"
      VALUE "ProductVersion", "@SKYDIAG_VERSION_STRING@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
